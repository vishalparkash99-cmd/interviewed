{
  "name": "interviewed",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "build:web": "npm run build -w @interviewed/types && npm run build -w @interviewed/config && npm run build -w apps/web",
    "build:ci": "npm run prisma:generate && npm run build -w @interviewed/types && npm run build -w @interviewed/config && npm run build -w @interviewed/queue && npm run build -w @interviewed/ai && npm run build -w @interviewed/storage && npm run build -w @interviewed/database && npm run build -w apps/worker && npm run build -w apps/api",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern='unit' --coverage=false",
    "test:integration": "jest --testPathPattern='integration' --coverage=false",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --ci",
    "prisma:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=packages/database/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=packages/database/prisma/schema.prisma",
    "prisma:seed": "tsx scripts/seed.ts",
    "prisma:studio": "prisma studio --schema=packages/database/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.9.0",
    "ai": "^4.0.0",
    "amqplib": "^0.10.5",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.2",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.0",
    "next": "14.2.35",
    "openai": "^6.49.0",
    "pino": "^9.3.5",
    "pino-pretty": "^11.2.2",
    "prisma": "^6.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
