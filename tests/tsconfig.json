{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": true,
    "types": ["jest", "node"],
    "lib": ["ES2022"]
  },
  "include": ["**/*.test.ts", "**/*.spec.ts"],
  "exclude": ["node_modules"]
}
