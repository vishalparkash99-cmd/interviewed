# ============================================
# Interviewed - AI Recruitment Platform
# Environment Variable Reference
# ============================================
#
# Two environment files are provided:
#
#   .env.localhost    - Local development against docker-compose services
#                       (Postgres, Redis, RabbitMQ, MailHog on localhost)
#                       Usage: cp .env.localhost .env
#
#   .env.development  - Development environment against cloud services
#                       (Neon Postgres, Upstash Redis, CloudAMQP)
#                       Usage: cp .env.development .env
#
# Copy the relevant file to `.env` before running the app.

# --- Database ---
# Localhost:  postgresql://postgres:postgres@localhost:5432/interviewed?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interviewed?schema=public"
# Direct (non-pooled) connection, used for migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/interviewed?schema=public"
# Unpooled alias for Prisma
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/interviewed?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# --- Redis ---
# Localhost:  redis://localhost:6379
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- RabbitMQ ---
# Localhost:  amqp://guest:guest@localhost:5672
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_QUEUE_RESUME_PARSING="resume.parsing"
RABBITMQ_QUEUE_MATCHING="candidate.matching"
RABBITMQ_QUEUE_AI_EVALUATION="ai.evaluation"
RABBITMQ_QUEUE_EMAIL="email.sending"
RABBITMQ_QUEUE_REPORT="report.generation"

# --- JWT ---
JWT_SECRET="change-me-in-production-at-least-64-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-in-production-refresh-token-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- AI ---
AI_PROVIDER="openrouter"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
DEFAULT_AI_MODEL="gpt-4o"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# --- Storage (S3-compatible) ---
STORAGE_PROVIDER="local"
STORAGE_BUCKET="interviewed-uploads"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE=true

# --- Email ---
# Localhost: smtp + MailHog (localhost:1025)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="noreply@interviewed.ai"
FROM_NAME="Interviewed"

# --- Application ---
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002
API_INTERNAL_URL="http://localhost:3001"
APP_URL="http://localhost:3000"

# --- Security ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES="application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"

# --- Interview ---
INTERVIEW_DEFAULT_DURATION=45
INTERVIEW_DEFAULT_DIFFICULTY="medium"
INTERVIEW_LINK_EXPIRY_HOURS=72
INTERVIEW_RECORDING_ENABLED=true

# --- Observability ---
LOG_LEVEL="info"
LOG_FORMAT="json"
SENTRY_DSN=""

# --- Data Retention ---
DATA_RETENTION_CANDIDATE_DATA_DAYS=365
DATA_RETENTION_INTERVIEW_RECORDINGS_DAYS=180

# --- Neon Branch ---
NEON_BRANCH="local"